{
  "compilerOptions": {
    "allowJs": true,
    "jsx": "react-jsxdev",
    "paths": {
      "react": ["../src/react.ts"],
      "react/jsx-runtime": ["../src/jsx-runtime.ts"],
      "react/jsx-dev-runtime": ["../src/jsx-runtime.ts"],
      "react-dom": ["../src/react-dom.ts"],
      "react-dom/client": ["../src/client.ts"],
      "react-dom/server": ["../src/server.ts"],
      "react-dom/server.browser": ["../src/server.ts"],
      "react-dom/server.node": ["../src/server.ts"],
      "react-dom/server.edge": ["../src/server.ts"],
      "react-dom/static": ["../src/server.ts"],
      "react-dom/static.browser": ["../src/server.ts"],
      "react-dom/static.node": ["../src/server.ts"],
      "react-dom/static.edge": ["../src/server.ts"],
      "react-dom/test-utils": ["./shim/test-utils.ts"],
      "react-noop-renderer": ["./shim/noop.ts"],
      "init.js": ["./shim/empty-script.ts"],
      "init.mjs": ["./shim/empty-script.ts"],
      "init2.js": ["./shim/empty-script.ts"],
      "init2.mjs": ["./shim/empty-script.ts"],
      "react-reconciler/constants": ["./shim/reconciler-constants.ts"],
      "use-sync-external-store": ["../src/external-store.ts"],
      "use-sync-external-store/shim": ["../src/external-store.ts"],
      "use-sync-external-store/shim/index.js": ["../src/external-store.ts"],
      "use-sync-external-store/with-selector": ["../src/external-store.ts"],
      "use-sync-external-store/with-selector.js": ["../src/external-store.ts"],
      "use-sync-external-store/shim/with-selector": ["../src/external-store.ts"],
      "use-sync-external-store/shim/with-selector.js": ["../src/external-store.ts"],
      "react-redux": ["../src/react-redux.ts"],
      "vitest": ["./shim/vitest.ts"],
      "@internal/hooks/useReduxContext": ["../src/react-redux.ts"],
      "@internal/utils/react-is": ["./shim/redux-react-is.ts"],
      "@internal/utils/react-is.js": ["./shim/redux-react-is.ts"],
      "scheduler": ["./shim/scheduler.ts"],
      "scheduler/unstable_mock": ["./shim/scheduler.ts"],
      "internal-test-utils": ["./shim/test-utils.ts"],
      "internal-test-utils/*": ["./react-tests/internal-test-utils/*"],
      "shared/*": ["./react-tests/shared/*"]
    }
  }
}
