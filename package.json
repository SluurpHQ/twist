{
  "name": "@sluurp/twist",
  "version": "0.1.0",
  "description": "One runtime for React's API and Solid 2's: fine-grained DOM on signals, server rendering, streaming and hydration, React and Solid-style components in the same tree.",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./src/twist/index.ts",
    "./store": "./src/twist/index.ts",
    "./web": { "node": "./src/twist/server.ts", "default": "./src/twist/web.ts" },
    "./server": "./src/twist/server.ts",
    "./jsx-runtime": { "node": "./src/twist/jsx/server/jsx-runtime.ts", "default": "./src/twist/jsx/client/jsx-runtime.ts" },
    "./jsx-dev-runtime": { "node": "./src/twist/jsx/server/jsx-dev-runtime.ts", "default": "./src/twist/jsx/client/jsx-dev-runtime.ts" },
    "./hot": "./src/twist/hot.ts",
    "./bridge": { "node": "./src/twist/react-bridge-server.ts", "default": "./src/twist/react-bridge.ts" },
    "./react": "./src/react.ts",
    "./react/jsx-runtime": "./src/jsx-runtime.ts",
    "./react/jsx-dev-runtime": "./src/jsx-runtime.ts",
    "./react-dom": "./src/react-dom.ts",
    "./react-dom/client": "./src/client.ts",
    "./react-dom/server": { "node": "./src/server.ts", "default": "./src/server.browser.ts" },
    "./react-redux": "./src/react-redux.ts",
    "./external-store": "./src/external-store.ts",
    "./signals": { "types": "./src/signals.d.ts", "default": "./src/signals.js" },
    "./serial": "./src/serial.js",
    "./modules": "./modules.js",
    "./vite": "./vite.js",
    "./compiler": "./napi/index.js"
  },
  "files": ["src", "napi/index.js", "napi/platform.js", "modules.js", "vite.js", "LICENSE", "README.md"],
  "scripts": {
    "build:compiler": "node scripts/build-compiler.mjs",
    "test": "cd test/bridge && bun test"
  },
  "peerDependencies": { "vite": ">=6", "react": ">=19", "react-dom": ">=19" },
  "peerDependenciesMeta": { "vite": { "optional": true }, "react": { "optional": true }, "react-dom": { "optional": true } },
  "devDependencies": {
    "oxc-parser": "0.151.0",
    "react": "19",
    "react-dom": "19",
    "seroval": "1.6.7"
  }
}
